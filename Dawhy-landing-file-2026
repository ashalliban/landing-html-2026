<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DAWHY PARTNERS | Global Strategic Advisory & Capital Architecture</title>
    <style>
        :root {
            --bg-dark: #070F16;
            --card-bg: #0F1D2A;
            --brand-purple: #9844B4;
            --brand-green: #3DC41A;
            --brand-cyan: #5BE7F6;
            --text-light: #F4F6F9;
            --text-muted: #8A9CAE;
            --border: rgba(152, 68, 180, 0.2);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
        body { background-color: var(--bg-dark); color: var(--text-light); line-height: 1.6; }

        /* Enterprise Header */
        header { position: sticky; top: 0; z-index: 1000; background: rgba(7, 15, 22, 0.85); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); padding: 1.5rem 8%; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-weight: 300; font-size: 1.3rem; letter-spacing: 3px; text-transform: uppercase; color: #FFF; text-decoration: none; display: flex; align-items: center; gap: 10px; }
        .logo-dot { width: 10px; height: 10px; background-color: var(--brand-green); border-radius: 50%; }

        /* Master Core Tabs Navigation */
        .tab-navigation { display: flex; overflow-x: auto; background: var(--card-bg); border-bottom: 1px solid var(--border); padding: 0 8%; sticky: top; top: 70px; z-index: 999; }
        .tab-btn { padding: 1.2rem 2rem; background: transparent; border: none; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; white-space: nowrap; transition: all 0.3s; border-bottom: 3px solid transparent; }
        .tab-btn:hover { color: #FFF; }
        .tab-btn.active { color: var(--brand-cyan); border-bottom-color: var(--brand-cyan); background: rgba(91, 231, 246, 0.02); }

        /* Viewport Panels */
        .content-panel { display: none; padding: 5rem 8%; max-width: 1400px; margin: 0 auto; min-height: 60vh; }
        .content-panel.active { display: block; animation: fadeIn 0.4s ease-out; }

        h2 { font-size: 2.5rem; font-weight: 200; margin-bottom: 1rem; letter-spacing: -0.5px; }
        h2 span { color: var(--brand-purple); }
        .panel-intro { font-size: 1.15rem; color: var(--text-muted); margin-bottom: 3.5rem; max-width: 800px; border-left: 2px solid var(--brand-cyan); padding-left: 20px; }

        /* Grid Architecture for Matrix Sub-items */
        .matrix-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
        .matrix-card { background: var(--card-bg); border: 1px solid rgba(255,255,255,0.03); padding: 2.5rem; border-top: 3px solid var(--brand-purple); transition: all 0.3s; }
        .matrix-card:hover { transform: translateY(-3px); border-top-color: var(--brand-cyan); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
        .matrix-card h3 { font-size: 1.25rem; font-weight: 400; margin-bottom: 1rem; color: #FFF; }
        
        .sub-list { list-style: none; }
        .sub-list li { font-size: 0.95rem; color: var(--text-muted); padding: 0.4rem 0; display: flex; align-items: center; gap: 8px; }
        .sub-list li::before { content: "▪"; color: var(--brand-cyan); }

        /* Settlement Terminal Card */
        .checkout-box { max-width: 550px; margin: 2rem auto; padding: 2.5rem; background: var(--bg-dark); border: 1px solid var(--border); }
        .form-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; }
        label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; color: var(--text-muted); }
        input, select { background: var(--card-bg); border: 1px solid rgba(255,255,255,0.1); padding: 0.85rem; color: #FFF; font-size: 0.95rem; }
        input:focus { border-color: var(--brand-cyan); outline: none; }
        .method-flex { display: flex; gap: 1rem; margin: 1.5rem 0; }
        .method-card { flex: 1; border: 1px solid var(--border); padding: 1rem; text-align: center; cursor: pointer; font-size: 0.85rem; color: var(--text-muted); }
        .method-card.active { border-color: var(--brand-cyan); background: rgba(91, 231, 246, 0.05); color: #FFF; }
        .btn-submit { background: transparent; color: #FFF; border: 2px solid var(--brand-cyan); padding: 1rem; width: 100%; font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; }
        .btn-submit:hover { background: var(--brand-cyan); color: var(--bg-dark); }

        /* Footer */
        footer { border-top: 1px solid var(--border); padding: 4rem 8%; background: #040A0F; font-size: 0.8rem; color: var(--text-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; }
        .footer-desc { max-width: 500px; text-align: justify; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
